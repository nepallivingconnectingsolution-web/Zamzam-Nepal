# ─────────────────────────────────────────────────────────────────────────
# Zamzam Server — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call this API (your Vite dev
# server, your deployed frontend domain, etc).
CORS_ORIGINS=http://localhost:5173

# Database — self-hosted Postgres (see docker-compose.yml at the repo
# root). When running the full stack via `docker compose up`, this value
# points at the `postgres` service over the internal Docker network — no
# sslmode needed, it never leaves the host. The user/password/db here
# must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB in the repo
# root's .env (see .env.example there).
#
# For local development without Docker, run Postgres yourself (e.g.
# `docker run -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:16-alpine`)
# and point this at localhost instead.
DATABASE_URL=postgresql://zamzam:replace-with-a-strong-password@postgres:5432/zamzam

# Auth — JWT secrets. Generate strong random values for production, e.g.:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Super admin auth uses its own, separate JWT secret and a shorter session —
# this token can never be confused with a regular user's access token even
# if the same secret value were accidentally reused, because the strategies
# also check a different `type` claim.
SUPER_ADMIN_JWT_SECRET=replace-with-yet-another-long-random-string
SUPER_ADMIN_JWT_EXPIRES_IN=12h

# Super admin — bootstrap credentials for the single super-admin account.
# Used only by `npm run db:seed:superadmin`. Rotate the password after first
# login is not supported yet (no self-service change-password endpoint), so
# pick a strong value here.
SUPER_ADMIN_EMAIL=superadmin@zamzam.com.np
# ⚠️ This password was also shared — change it before seeding.
SUPER_ADMIN_PASSWORD=CHANGE-ME-strong-password
SUPER_ADMIN_NAME=Super Admin

# Rate limiting (requests per window, per IP) for auth endpoints.
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_LIMIT=10

# Google Sign-In (customer accounts only — see modules/auth). OAuth Client ID
# from Google Cloud Console → APIs & Services → Credentials. Not secret — also
# baked into the client build as VITE_GOOGLE_CLIENT_ID. The matching Client
# Secret is NOT used by this flow (it's an ID-token verification flow) and
# should never be put in this file or committed anywhere.
GOOGLE_CLIENT_ID=

# Redis — backs rate limiting (see docker-compose.yml). Without this set,
# rate limits still work but reset on every restart/deploy instead of
# persisting.
REDIS_URL=redis://redis:6379

# Outbound email (forgot-password OTP, and anything else that emails users
# going forward) — sent via Resend (https://resend.com). Without
# RESEND_API_KEY set, emails are logged to the server console instead of
# sent, so the forgot-password flow is still fully testable in local dev.
# MAIL_FROM must be a domain verified in your Resend account; the
# onboarding@resend.dev sender below only works for testing to your own
# Resend account email.
RESEND_API_KEY=
MAIL_FROM=Zamzam <onboarding@resend.dev>

# AWS Rekognition — moderates image uploads (driver/partner documents)
# before they're saved. Without AWS_REGION set, uploads are NOT moderated
# (local dev only — main.ts refuses to start in production without this).
# IAM user should be scoped to rekognition:DetectModerationLabels only.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Confidence threshold (0-100) above which a label rejects the upload.
REKOGNITION_MIN_CONFIDENCE=80

# Sentry — server-side error tracking. Only active when NODE_ENV=production
# AND this is set; local dev stays silent. Get the DSN from your Sentry
# project settings (Client Keys / DSN).
SENTRY_DSN_SERVER=

# ── Driver onboarding, verification and dispatch ────────────────────────

# Private storage for driver identity / vehicle documents. NOT served
# statically: files are only readable through authenticated endpoints (the
# owning driver, or a super admin). Mount a persistent volume here and back
# it up. Defaults to ./private-uploads.
UPLOAD_PRIVATE_DIR=/app/private-uploads

# Phone-number OTP for driver sign-up. `console` prints the code in the
# server log (development only; the server refuses it in production).
# `sparrow` sends a real SMS through Sparrow SMS (Nepal): needs a token and an
# approved sender identity from your Sparrow account.
SMS_PROVIDER=console
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=

# Temporary escape hatch: lets SMS_PROVIDER=console run in production (prints
# the OTP to the server log via `pm2 logs` instead of sending a real SMS) for
# manual testing before real Sparrow SMS credentials exist. Requires BOTH this
# AND SMS_PROVIDER=console to be set — never set this on a real production
# deployment serving real users. Remove it the moment real credentials land.
ALLOW_CONSOLE_SMS_IN_PRODUCTION=

# Ride offers. Each offer expires after OFFER_TTL_SECONDS; up to OFFER_BATCH_SIZE
# nearest eligible drivers are asked at a time, for at most OFFER_MAX_ROUNDS
# rounds, within DISPATCH_RADIUS_KM of the pickup. A driver's location counts
# as current for LOCATION_FRESH_SECONDS. (REDIS_URL above also holds live
# driver locations, so set it in production.)
OFFER_TTL_SECONDS=15
OFFER_BATCH_SIZE=3
OFFER_MAX_ROUNDS=3
DISPATCH_RADIUS_KM=8
LOCATION_FRESH_SECONDS=90

# Cloudinary — business image storage/CDN (hotel/room/bus/vehicle/restaurant/
# grocery photos). Get a free cloud at https://cloudinary.com, or use the
# Claimable Cloud flow for a no-signup dev cloud. Format:
# cloudinary://<api_key>:<api_secret>@<cloud_name>
# Unset in dev/test is fine — the app boots normally; upload endpoints will
# return a 503 if actually called without this set.
CLOUDINARY_URL=
