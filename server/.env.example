# ─────────────────────────────────────────────────────────────────────────
# Zamzam Server — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call this API (your Vite dev
# server, your deployed frontend domain, etc).
CORS_ORIGINS=http://localhost:5173

# Database — self-hosted Postgres (see docker-compose.yml at the repo
# root). When running the full stack via `docker compose up`, this value
# points at the `postgres` service over the internal Docker network — no
# sslmode needed, it never leaves the host. The user/password/db here
# must match POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB in the repo
# root's .env (see .env.example there).
#
# For local development without Docker, run Postgres yourself (e.g.
# `docker run -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:16-alpine`)
# and point this at localhost instead.
DATABASE_URL=postgresql://zamzam:replace-with-postgres-password@postgres:5432/zamzam

# Auth — JWT secrets. Generate strong random values for production, e.g.:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Super admin auth uses its own, separate JWT secret and a shorter session —
# this token can never be confused with a regular user's access token even
# if the same secret value were accidentally reused, because the strategies
# also check a different `type` claim.
SUPER_ADMIN_JWT_SECRET=replace-with-yet-another-long-random-string
SUPER_ADMIN_JWT_EXPIRES_IN=12h

# Super admin — bootstrap credentials for the single super-admin account.
# Used only by `npm run db:seed:superadmin`. Rotate the password after first
# login is not supported yet (no self-service change-password endpoint), so
# pick a strong value here.
SUPER_ADMIN_EMAIL=superadmin@zamzam.com.np
# ⚠️ This password was also shared — change it before seeding.
SUPER_ADMIN_PASSWORD=CHANGE-ME-strong-password
SUPER_ADMIN_NAME=Super Admin

# Rate limiting (requests per window, per IP) for auth endpoints.
AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_RATE_LIMIT_LIMIT=10

# Outbound email (forgot-password OTP, and anything else that emails users
# going forward) — sent via Resend (https://resend.com). Without
# RESEND_API_KEY set, emails are logged to the server console instead of
# sent, so the forgot-password flow is still fully testable in local dev.
# MAIL_FROM must be a domain verified in your Resend account; the
# onboarding@resend.dev sender below only works for testing to your own
# Resend account email.
RESEND_API_KEY=
MAIL_FROM=Zamzam <onboarding@resend.dev>
